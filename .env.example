# Configuración de PostgreSQL
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change_this_password

# Configuración de n8n
N8N_TIMEZONE=America/Argentina/Buenos_Aires

# Configuración de ngrok
NGROK_AUTHTOKEN=your_ngrok_auth_token_here

# URL pública de ngrok (actualizar cuando cambie)
N8N_WEBHOOK_URL=https://your-ngrok-url.ngrok-free.dev

# Configuración de n8n Sandbox (ejecución segura de código / AI)
N8N_SANDBOX_VERSION=1.17.0
SANDBOX_PORT=3200
SANDBOX_API_KEY=n8n_sandbox_secret_key_2026
SANDBOX_REGISTRATION_TOKEN=n8n_sandbox_reg_token_2026
SANDBOX_RUNNER_KEY=n8n_sandbox_runner_key_2026
